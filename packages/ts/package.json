{
  "name": "@qorechain/qoresign",
  "version": "0.1.1",
  "description": "Hybrid secp256k1 + ML-DSA-87 (FIPS 204) signing, verification and Sign In With QoreChain for wallets and backends on QoreChain.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "homepage": "https://github.com/qorechain/qoresign#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qoresign.git",
    "directory": "packages/ts"
  },
  "bugs": {
    "url": "https://github.com/qorechain/qoresign/issues"
  },
  "keywords": [
    "qorechain",
    "ml-dsa",
    "fips-204",
    "post-quantum",
    "hybrid-signature",
    "wallet",
    "cosmos-sdk",
    "siwe"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./network": {
      "import": {
        "types": "./dist/network.d.ts",
        "default": "./dist/network.js"
      },
      "require": {
        "types": "./dist/network.d.cts",
        "default": "./dist/network.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/pqc": "0.2.3",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0"
  },
  "devDependencies": {
    "@cosmjs/amino": "0.39.0",
    "@cosmjs/proto-signing": "0.39.0",
    "@qorechain/sdk": "0.10.0",
    "cosmjs-types": "0.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
